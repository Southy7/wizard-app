# Use consistent line endings for all text files across operating systems.
* text=auto eol=lf

# Keep Windows command files compatible with the Windows command processor.
*.bat text eol=crlf
*.cmd text eol=crlf

# Do not apply text conversions to binary assets.
*.gif binary
*.ico binary
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.woff binary
*.woff2 binary

# Keep deployment archives focused on runtime files.
/.github export-ignore
/examples export-ignore
/tests export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/package.json export-ignore
/package-lock.json export-ignore
/requirements-test.txt export-ignore
/eslint.config.cjs export-ignore
/.prettierignore export-ignore
/.prettierrc.json export-ignore
/tsconfig.check.json export-ignore
